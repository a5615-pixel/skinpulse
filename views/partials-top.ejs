<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="SkinPulse — análise de inventário CS2.">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<div class="wrap">
<nav>
  <a class="logo" href="/">Skin<span>Pulse</span></a>
  <div class="navlinks">
    <a class="btn ghost" href="<%= discord %>" target="_blank" rel="noopener">Discord</a>
    <a class="btn ghost" href="<%= whatsapp %>" target="_blank" rel="noopener">WhatsApp</a>
    <% if (user) { %>
      <a class="btn secondary" href="/dashboard">Conta</a>
      <% if (isAdmin) { %><a class="btn secondary" href="/admin">Admin</a><% } %>
      <form method="post" action="/logout" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="ghost" type="submit">Sair</button>
      </form>
    <% } else { %>
      <a class="btn ghost" href="/login">Entrar</a>
      <a class="btn secondary" href="/register">Criar conta</a>
    <% } %>
  </div>
</nav>
